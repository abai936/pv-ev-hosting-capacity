---
// A number never appears alone: value + unit + label + caveat + source file in one block.
interface Props { label: string; value: string; unit?: string; caveat: string; source: string; limit?: boolean; volt?: boolean; }
const { label, value, unit, caveat, source, limit = false, volt = false } = Astro.props;
---
<li class:list={['card', { limit, volt }]}>
  <p class="card-label">{label}</p>
  <p class="card-value">{value}{unit && <>{' '}<span class="unit">{unit}</span></>}</p>
  <p class="card-caveat">{caveat}</p>
  <p class="card-source">Source: <code>{source}</code></p>
</li>
